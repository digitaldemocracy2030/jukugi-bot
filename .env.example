# ============================================
# Self-hosted LiveKit (default for local dev)
# ============================================
LIVEKIT_URL=http://livekit-server:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_WEBHOOK_SECRET=secret

# Frontend — browser connects directly to localhost
VITE_API_URL=http://localhost:8787
VITE_LIVEKIT_URL=ws://localhost:7880

# Admin API
ADMIN_API_KEY=my-local-admin-key-12345

# MinIO (S3-compatible local storage for recordings)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000

# Transcription Agent (STT)
TRANSCRIPTION_AGENT_NAME=transcription-agent
# DEEPGRAM_API_KEY=           # Set your Deepgram API key to enable transcription

# ============================================
# LiveKit Cloud (uncomment to use cloud instead)
# ============================================
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret
# LIVEKIT_WEBHOOK_SECRET=your-webhook-secret
# VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
# STORAGE_ENDPOINT=https://your-r2-endpoint
# STORAGE_ACCESS_KEY=your-r2-access-key
# STORAGE_SECRET_KEY=your-r2-secret-key
# STORAGE_PUBLIC_URL=https://your-r2-public-url
